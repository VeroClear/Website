# HTML und PHP nicht zwischenspeichern, damit Änderungen sofort sichtbar sind.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# www.veroclear.de dauerhaft auf veroclear.de umleiten (eine Adresse für Google).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.veroclear\.de$ [NC]
  RewriteRule ^ https://veroclear.de%{REQUEST_URI} [L,R=301]
</IfModule>
